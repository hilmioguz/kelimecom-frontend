<%- contentFor('headerBlock') %>
<title>Kelime.com Giriş</title>
<link rel="stylesheet" type="text/css" href="/login-assets/css/bootstrap.min.css">
<link rel="stylesheet" type="text/css" href="/login-assets/css/fontawesome-all.min.css">
<link rel="stylesheet" type="text/css" href="/login-assets/css/iofrm-style.css">
<link rel="stylesheet" type="text/css" href="/login-assets/css/iofrm-theme3.css">
<style>
    .form-content label.error {
      color: #ad4a01!important;
    }
</style>
<%- contentFor('body') %>
<div class="form-body" class="container-fluid">
    <div class="website-logo">
        <a href="/">
            <div class="logo">
                <img class="logo-size" src="/assets/img/logo.svg" alt="">
            </div>
        </a>
    </div>
    <div class="row">
        <div class="img-holder">
            <div class="bg"></div>
            <div class="info-holder">

            </div>
        </div>
        <div class="form-holder">
            <div class="form-content">
                <div class="form-items">
                    <div class="page-links">
                        <a href="/login"><%- __('login_') %></a><a href="/register"><%- __('register_') %></a>
                    </div>
                    <h5 class="text-center mb-5"><%- __('renew_password') %></h5>
                    <form id="forgot-form" method="post" action="javascript:;">
                        <input class="form-control" type="text" name="email" placeholder="<%- __('email') %>" autocomplete="current-email" required>
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="form-button">
                                <button id="forgot-button" type="button" class="ibtn"><%- __('send') %></button>
                            </div>
                        </div>
                    </form>
                    <div class="other-links d-flex align-items-center">
                        <span><%- __('social_login') %> </span><a href="#"><i class="fab fa-facebook-f"></i></a><a href="/auth/google"><i class="fab fa-google"></i></a><a href="#"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- contentFor('footerBlock') %>
<script>
$(document).ready(function () {
  const filedrequired = `<%- __('field_required') %>`;
  const invalidemail = `<%- __('invalid_email') %>`;
  const giristext = `<%- __('login_') %>`;
  const errortext = `<%- __('error') %>`;
  const wronglogin= `<%- __('wrong_login') %>`;
  const registertext = `<%- __('register') %>`;
  const atleastcriter = `<%- __('atleast_criter') %>`;
  const invalidemailcriter = `<%- __('invalid_email_criter') %>`;
  const minlengthcriter = `<%- __('minlength') %>`;
  const minlengthchar = `<%- __('minlengthcharacter') %>`;
  const notmatch = `<%- __('passwordnotmatched') %>`;
  const successheader = `<%- __('success') %>`;
  const successmessage = `<%- __('register_success_msg') %>`;
  $("#forgot-form").validate({
    rules: {
      email: {
        required: true,
        email: true,
        validEmail: true,
      },
    },
    messages: {
      email: {
        required: filedrequired,
        email: invalidemail,
      },
    },
  });

  $("button#forgot-button").on("click", function () {
    if ($("#forgot-form").valid()) {
      $(this).prop("disabled", true);
      $(this).html('<i class="fa fa-spinner fa-spin fa-lg fa-fw"></i>');
      const that = this;
      $.ajax({
        url: "/forgot-password",
        method: "post",
        data: $("form#forgot-form").serialize(),
        success: function (result) {
          Swal.fire({
            title: successheader,
            text: result,
            type: "success",
            heightAuto: false,
          }).then(() => {
            window.location = "/";
          });
        },
        error: function (err) {
          $(that).html(sendtext);
          $(that).prop("disabled", false);
          Swal.fire({
            title: errortext,
            text: err.responseJSON.message,
            type: "warning",
            heightAuto: false,
          });
        },
      });
    }
  });

 });

</script>
