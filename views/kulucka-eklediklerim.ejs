          const updateSendeEkleForm = (data, tabschange = false) => {
            $("#sendeekleform").html();
            const initialAnnotations = {};
            var loadedannotations = JSON.parse(data.whichDict ? data.whichDict.bulunduguSayfalar: []);
            loadedannotations.map((annom) => {
              var $annom = annom;
              $annom = JSON.parse(annom ? annom.annotation:[]);
              $annom.map((a) => {
                if (a && a.target && a.target.selector && a.target.selector.value) {
                  a.target.selector.value = decodeHTMLEntities(a.target.selector.value);
                }
              });
              if (annom.url) {
                const filename = annom.url.substring(annom.url.lastIndexOf('/') + 1);
                initialAnnotations[annom.url] = $annom;
              }
              return $annom;
            });
            let imagedata = [];
            imagedata = JSON.parse('<%-selectedSet && selectedSet.pages ? JSON.stringify(selectedSet.pages):[]%>');
            var theTileSources = [];
            if (imagedata.length > 0) {
              imagedata.forEach((image) => {
                theTileSources.push({
                  type: 'image',
                  url: image,
                });
              });
            }
            const ni = '<%-nextSet ? JSON.stringify(nextSet): []%>';
            let nextimagedata = null;
            if (ni) {
              let nextimagedata = JSON.parse(ni);
              if (nextimagedata) {
                nextimagedata.pages.forEach((image, i) => {
                  theTileSources.push({
                    type: 'image',
                    url: image,
                  });
                });
              }
            }
            viewer = OpenSeadragon({
              id: "openseadragon1",
              prefixUrl: "/assets/js/openseadragon/images/",
              showNavigator: true,
              sequenceMode: true,
              debugMode: false,
              showReferenceStrip: true,
              autoHideControls: false,
              //referenceStripScroll: 'vertical',
              tileSources: theTileSources,
            });
            if (msgekle === null) {
              if (nextimagedata) {
                msgekle = `<div class="alert alert-info">Sondaki ${nextimagedata.pages.length} sayfa referans işlemi için sunulmaktadır. Madde girişi yapmayınız.</div>`;
                $(msgekle).insertAfter('#sonrakiSetYukle');
              }
            }

            var anno = OpenSeadragon.Annotorious(viewer, {
              disableEditor: true,
            });

            Annotorious.SelectorPack(anno, {
              tools: ['rect', 'polygon', 'circle']
            });
            Annotorious.Toolbar(anno, document.getElementById('openseadragon1'));
            Annotorious.BetterPolygon(anno);
            Annotorious.SequenceMode(anno, viewer, { initialAnnotations });
            if (initialAnnotations) {
              bulunduguMap.clear();
              for (const [key, value] of Object.entries(initialAnnotations)) {
                bulunduguMap.set(key, JSON.stringify(value));
              }
            }
            anno.on('createSelection', async function (selection) {
              // Tag to insert
              selection.body = [{
                type: 'TextualBody',
                purpose: 'tagging',
                value: 'Maddebasi'
              }];

              await anno.updateSelected(selection);
              anno.saveSelected();
            });

            anno.on('createAnnotation', async function (annotation, overrideId) {
              console.log('createAnnotation:', annotation, overrideId);
              // console.log('sayfa:', viewer.currentPage(), imagedata.pages[viewer.currentPage()]);
              const koordinates = await anno.getAnnotations();
              bulunduguMap.set(imagedata[viewer.currentPage()], JSON.stringify(koordinates));
            });

            anno.on('deleteAnnotation', async function (annotation) {
              const koordinates = await anno.getAnnotations();
              bulunduguMap.set(imagedata[viewer.currentPage()], JSON.stringify(koordinates));
            });

            anno.on('updateAnnotation', async function (annotation, previous) {
              const koordinates = await anno.getAnnotations();
              bulunduguMap.set(imagedata[viewer.currentPage()], JSON.stringify(koordinates));
            });
            if (initialAnnotations && theTileSources) {
              const firstanno = Object.keys(initialAnnotations)[0];
              const foundpage = theTileSources.findIndex((tile) => tile.url === firstanno);
              viewer.goToPage(foundpage);
            }

            const index = kuluckalarim.findIndex((kulucka) => kulucka.whichDict._id === data.whichDict._id);
            console.log('index:', index, kuluckalarim[index]);
            $('#recordId').val(kuluckalarim[index]._id);
            $('#navKuluckaCurrent').html(kuluckalarim[index].madde);
            if (index !== 0) {
              $('#navKuluckaPrev').attr('data-index', index - 1);
              $('#navKuluckaPrev').show();
            } else {
              $('#navKuluckaPrev').hide();
            }
            if (index !== kuluckalarim.length - 1) {
              $('#navKuluckaNext').attr('data-index', index + 1);
              $('#navKuluckaNext').show();
            } else {
              $('#navKuluckaNext').hide();
            }

            $(`select[name="dil"] option[value='${data.whichDict.dili}']`).attr("selected", "selected");
            $('input[name="madde"]').val(data.madde);
            $('input[name="userSubmitted"]').val(data.whichDict.userSubmitted);
            if (data.whichDict.sesDosyasi) {
              $('input[name="sesDosyasi"]').val(data.whichDict.sesDosyasi);
              $(`a[data-name='sesDosyasi']`).addClass('fileUploaded');
              $(`<div class="viewUpload btn btn-light" data-name="sesDosyasi"><a href="#" data-name="sesDosyasi" class="uploadDelete ma-auto">🗑️</a><a href="${data.whichDict.sesDosyasi}" target="_blank" class="ma-auto">🔗</a></div>`).insertAfter(`a[data-name='sesDosyasi']`);
            }

            if (target !== 'söz') {
              if (data.digeryazim && data.digeryazim.length > 0) {
                console.log('Diger yazım :', JSON.stringify(data.digeryazim));
                data.digeryazim.forEach((diger) => {
                  var newOption = new Option(diger, diger, true, true);
                  $('select[name="digeryazim"]').append(newOption).trigger('change');
                });
              }
            }
            if (target === 'söz') {
              if (data.whichDict.sozusoyleyen) {
                $('input[name="sozusoyleyen"]').val(data.whichDict.sozusoyleyen);
              }
            }
            if (data.whichDict.karsi && data.whichDict.karsi.length > 0) {
              data.whichDict.karsi.forEach(function (kardil, ix) {
                if (kardil.anlam) {
                  $('textarea[name="karsianlam"]').val(kardil.anlam);
                  $(".karsianlamAc").trigger('click');
                }
                if (ix === 0) {
                  if (kardil.dili) {
                    $(`.karsidilSection select[name="karsidil"] option[value='${kardil.dili}']`).attr("selected", "selected");
                  }
                  if (kardil.madde) {
                    $('.karsidilSection input[name="karsimadde"]').val(kardil.madde);
                  }
                  if (kardil.sesDosyasi) {
                    $('.karsidilSection input[name="karsisesDosyasi"]').val(kardil.sesDosyasi);
                    const did = $('.karsidilSection input[name="karsisesDosyasi"]').attr('data-name');
                    $(`.karsidilSection a[data-name="${did}"]`).addClass('fileUploaded');
                    $(`<div class="viewUpload btn btn-light" data-name="karsisesDosyasi"><a href="#" data-name="karsisesDosyasi" class="uploadDelete ma-auto">🗑️</a><a href="${kardil.sesDosyasi}" target="_blank" class="ma-auto">🔗</a></div>`).insertAfter('.karsidilSection input[name="karsisesDosyasi"]');
                  }
                  if (kardil.digeryazim && kardil.digeryazim.length > 0) {
                    console.log('karDiger yazım :', JSON.stringify(kardil.digeryazim));
                    kardil.digeryazim.forEach((kdiger) => {
                      var newOption = new Option(kdiger, kdiger, true, true);
                      $('.karsidilSection select[name="karsidigeryazim"]').append(newOption).trigger('change');
                    });
                  }
                } else {
                  $('#karsiDilEkle').trigger('click');
                  setTimeout(function () {
                    if (kardil.dili) {
                      $(`.karsidilSection select[name="karsidil"] option[value='${kardil.dili}']`).eq(ix).attr("selected", "selected");
                    }
                    if (kardil.madde) {
                      $(`.karsidilSection input[name="karsimadde"]`).eq(ix).val(kardil.madde);
                    }
                    if (kardil.sesDosyasi) {
                      const did = $('.karsidilSection input[name="karsisesDosyasi"]').eq(ix).attr('data-name');
                      $(`.karsidilSection input[name="karsisesDosyasi"]`).eq(ix).val(kardil.sesDosyasi);
                      $(`.karsidilSection a[data-name="${did}"]`).addClass('fileUploaded');
                      $(`<div class="viewUpload btn btn-light" data-name="karsisesDosyasi"><a href="#" data-name="karsisesDosyasi" class="uploadDelete ma-auto">🗑️</a><a href="${kardil.sesDosyasi}" target="_blank" class="ma-auto">🔗</a></div>`).insertAfter(`.karsidilSection input[name="karsisesDosyasi"]:eq(${ix})`);
                    }

                    if (kardil.digeryazim && kardil.digeryazim.length > 0) {
                      console.log('kkarDiger yazım :', JSON.stringify(kardil.digeryazim));

                      kardil.digeryazim.forEach((kkdiger) => {
                        var newOption = new Option(kkdiger, kkdiger, true, true);
                        $('.karsidilSection select[name="karsidigeryazim"]').eq(ix).append(newOption).trigger('change');
                      });
                    }
                  }, 300);
                }
              });
            }

            if (target === 'eser') {
              if (data.whichDict.eserindili) {
                $('input[name="eserindili"]').val(data.whichDict.eserindili);
              }
              if (data.whichDict.eserindonemi) {
                $('input[name="eserindonemi"]').val(data.whichDict.eserindonemi);
              }
              if (data.whichDict.eserinyili) {
                $('input[name="eserinyili"]').val(data.whichDict.eserinyili);
              }
              if (data.whichDict.eserinyazari) {
                $('input[name="eserinyazari"]').val(data.whichDict.eserinyazari);
              }
            }

            if (data.whichDict.anlam) {
              $('textarea[name="anlam"]').val(data.whichDict.anlam);
            }
            if (target === 'kelime' || target === 'tamlama' || target === 'kalıp' || target === 'atasözü' || target === 'deyim') {
              if (data.whichDict.sekil && data.whichDict.sekil.length > 0) {
                data.whichDict.sekil.forEach(function (sek, sx) {
                  if (sx === 0) {
                    if (sek.aciklama) {
                      $('.sekilSection input[name="sekilaciklama"]').val(sek.aciklama);
                    }
                    if (sek.url) {
                      const did = $('.sekilSection input[name="sekilresim"]').attr('data-name');
                      $(`.sekilSection a[data-name="${did}"]`).addClass('fileUploaded');
                      $(`<div class="viewUpload btn btn-light" data-name="sekilresim"><a href="#" data-name="sekilresim" class="uploadDelete ma-auto">🗑️</a><a href="${sek.url}" target="_blank" class="ma-auto">🔗</a></div>`).insertAfter('.sekilSection input[name="sekilresim"]');
                      $('.sekilSection input[name="sekilresim"]').val(sek.url);
                    }
                  } else {
                    $('#sekilEkle').trigger('click');
                    setTimeout(function () {
                      if (sek.aciklama) {
                        $(`.sekilSection input[name="sekilaciklama"]`).eq(sx).val(sek.aciklama);
                      }
                      if (sek.url) {
                        const did = $('.sekilSection input[name="sekilresim"]').eq(sx).attr('data-name');
                        $(`.sekilSection input[name="sekilresim"]`).eq(sx).val(sek.url);
                        $(`.sekilSection a[data-name="${did}"]`).addClass('fileUploaded');
                        $(`<div class="viewUpload btn btn-light" data-name="sekilresim"><a href="#" data-name="sekilresim" class="uploadDelete ma-auto">🗑️</a><a href="${sek.url}" target="_blank" class="ma-auto">🔗</a></div>`).insertAfter(`.sekilSection input[name="sekilresim"]:eq(${sx})`);
                      }
                    }, 400);
                  }
                });
              }
            }

            if (target === 'tamlama' || target === 'kalıp' || target === 'atasözü' || target === 'deyim') {
              if (data.whichDict.kokleri && data.whichDict.kokleri.length > 0) {
                data.whichDict.kokleri.forEach(function (kok) {
                  var newOption = new Option(kok, kok, true, true);
                  $('.kokleriInput').append(newOption).trigger('change');
                });
              }
            }

            if (target === 'kelime') {
              if (data.whichDict.kokendili) {
                const foundkarsidil = aktifDiller.find((adil) => adil.value === data.whichDict.kokendili);
                if (foundkarsidil) {
                  $(`select[name="kokendili"] option[value='${data.whichDict.kokendili}']`).attr("selected", "selected");
                } else {
                  var newOption = new Option(data.whichDict.kokendili, data.whichDict.kokendili, true, true);
                  $('.kokenDiliInput').append(newOption).trigger('change');
                  $(`select[name="kokendili"] option[value='${data.whichDict.kokendili}']`).attr("selected", "selected");
                }
              }
              if (data.whichDict.kokeni) {
                $('input[name="kokeni"]').val(data.whichDict.kokeni);
              }
              setTimeout(function() {
                if (data.whichDict.tur && data.whichDict.tur.length > 0) {
                  data.whichDict.tur.forEach(function (tur) {
                    var newOption = new Option(tur, tur, true, true);
                    $('.turInput').append(newOption).trigger('change');
                  });
                }
                if (data.whichDict.alttur && data.whichDict.alttur.length > 0) {
                  data.whichDict.alttur.forEach(function (alttur) {
                    var newOption = new Option(alttur, alttur, true, true);
                    $('.altturInput').append(newOption).trigger('change');
                  });
                }
                if (data.whichDict.cinsiyet && data.whichDict.cinsiyet.length > 0) {
                  data.whichDict.cinsiyet.forEach(function (cinsiyet) {
                    var newOption = new Option(cinsiyet, cinsiyet, true, true);
                    $('.cinsiyetInput').append(newOption).trigger('change');
                  });
                }
                if (data.whichDict.bicim && data.whichDict.bicim.length > 0) {
                  data.whichDict.bicim.forEach(function (bicim) {
                    var newOption = new Option(bicim, bicim, true, true);
                    $('.bicimInput').append(newOption).trigger('change');
                  });
                }
                if (data.whichDict.sinif && data.whichDict.sinif.length > 0) {
                  data.whichDict.sinif.forEach(function (sinif) {
                    var newOption = new Option(sinif, sinif, true, true);
                    $('.sinifiInput').append(newOption).trigger('change');
                  });
                }
                if (data.whichDict.transkripsiyon && data.whichDict.transkripsiyon.length > 0) {
                  data.whichDict.transkripsiyon.forEach(function (transkripsiyon) {
                    var newOption = new Option(transkripsiyon, transkripsiyon, true, true);
                    $('.transkripsiyonInput').append(newOption).trigger('change');
                  });
                }
                if (data.whichDict.fonetik && data.whichDict.fonetik.length > 0) {
                  data.whichDict.fonetik.forEach(function (fonetik) {
                    var newOption = new Option(fonetik, fonetik, true, true);
                    $('.fonetikInput').append(newOption).trigger('change');
                  });
                }
                if (data.whichDict.heceliyazim && data.whichDict.heceliyazim.length > 0) {
                  data.whichDict.heceliyazim.forEach(function (heceliyazim) {
                    var newOption = new Option(heceliyazim, heceliyazim, true, true);
                    $('.heceliyazimInput').append(newOption).trigger('change');
                  });
                }
                if (data.whichDict.zitanlam && data.whichDict.zitanlam.length > 0) {
                  data.whichDict.zitanlam.forEach(function (zitanlam) {
                    var newOption = new Option(zitanlam, zitanlam, true, true);
                    $('.zitanlamInput').append(newOption).trigger('change');
                  });
                }
                if (data.whichDict.esanlam && data.whichDict.esanlam.length > 0) {
                  data.whichDict.esanlam.forEach(function (esanlam) {
                    var newOption = new Option(esanlam, esanlam, true, true);
                    $('.esanlamInput').append(newOption).trigger('change');
                  });
                }
              }, 800);
            }

            if (target === 'eser') {
              if (data.whichDict.esertxt) {
                $('input[name="esertxt"]').val(data.whichDict.esertxt);
                $(`.eserTxtSection a[data-name="esertxt"]`).addClass('fileUploaded');
                $(`<div class="viewUpload btn btn-light" data-name="esertxt"><a href="#" data-name="esertxt" class="uploadDelete ma-auto">🗑️</a><a href="${data.whichDict.esertxt}" target="_blank" class="ma-auto">🔗</a></div>`).insertAfter('.eserTxtSection input[name="esertxt"]');
              }
            }
            if (target === 'yapı' || target === 'yeradı') {
              if (data.whichDict.location && data.whichDict.location.length > 0) {

                $('#locationMap').locationpicker({
                  location: {
                    latitude: data.whichDict.location[0],
                    longitude: data.whichDict.location[1]
                  },
                  enableAutocomplete: true,
                  inputBinding: {
                    latitudeInput: $('#us2-lat'),
                    longitudeInput: $('#us2-lon'),
                    locationNameInput: $('#us2-address')
                  }
                });
                $('#us2-lat').val(data.whichDict.location[0]);
                $('#us2-lon').val(data.whichDict.location[1]);
                $('#locationMap').locationpicker('autosize');
               // $('#us2-address').val(null);
              } else {
                $('#locationMap').locationpicker({
                  enableAutocomplete: true,
                  inputBinding: {
                    latitudeInput: $('#us2-lat'),
                    longitudeInput: $('#us2-lon'),
                    locationNameInput: $('#us2-address')
                  }
                });
                $('#us2-lat').val(null);
                $('#us2-lon').val(null);
                $('#locationMap').locationpicker('autosize');
              }
            }
            if (target === 'yeradı') {
              if (data.whichDict.tarihcesi && data.whichDict.tarihcesi.length > 0) {
                data.whichDict.tarihcesi.forEach(function (tarih, tx) {
                  if (tx === 0) {
                    if (tarih.baslangic) {
                      $('.tariharaligiSection input[name="tarihcesibaslangic"]').val(tarih.baslangic);
                    }
                    if (tarih.bitis) {
                      $('.tariharaligiSection input[name="tarihcesibitis"]').val(tarih.bitis);
                    }
                    if (tarih.adi) {
                      $('.tariharaligiSection input[name="tarihcesiadi"]').val(tarih.adi);
                    }
                    if (tarih.hakimiyet) {
                      $('.tariharaligiSection input[name="tarihcesihakimiyet"]').val(tarih.hakimiyet);
                    }
                  } else {
                    $('#tariharaligiEkle').trigger('click');
                    setTimeout(function () {
                      if (tarih.baslangic) {
                        $(`.tariharaligiSection input[name="tarihcesibaslangic"]`).eq(tx).val(tarih.baslangic);
                      }
                      if (tarih.bitis) {
                        $(`.tariharaligiSection input[name="tarihcesibitis"]`).eq(tx).val(tarih.bitis);
                      }
                      if (tarih.adi) {
                        $(`.tariharaligiSection input[name="tarihcesiadi"]`).eq(tx).val(tarih.adi);
                      }
                      if (tarih.hakimiyet) {
                        $(`.tariharaligiSection input[name="tarihcesihakimiyet"]`).eq(tx).val(tarih.hakimiyet);
                      }
                    }, 200);
                  }
                });
              }
            }

            if (data.whichDict.bulunduguSayfalar) {
              $('input[name="bulunduguSayfalar"]').val(data.whichDict.bulunduguSayfalar);
            }
            if (!tabschange) {
              $(`a[data-tip="${data.whichDict.tip[0]}"]`).trigger('click');
              $('#tipInputField').val(data.whichDict.tip[0]);
            }
          };
          $('#formUpdate').on('hidden.bs.modal', function () {
            viewer.destroy();
            viewer = null;
            $("#sendeekleform").html(templateCopy);
            initialLoad();
            window.location.reload();
          });
        });
      </script>