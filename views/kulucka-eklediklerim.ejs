  <style>
    .select2-container--default.select2-container--focus .select2-selection--multiple {
      border: 1px solid #ced4da;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice {
      background-color: #e4e4e4;
      border: 1px solid #ced4da;
    }

    .select2-container .select2-selection--multiple {
      min-height: 38px;
      width: 100%;
    }

    .select2 {
      width: 100% !important;
    }

    .select2-container--default .select2-selection--multiple {
      background-color: white;
      border: 1px solid #ced4da;
      max-width: 200px;
    }
    .select2-selection--single {
      background-color: white!important;
      border: 1px solid #ced4da!important;
      min-height: 38px;
    }
    .md-header .btn-group .btn-outline-secondary {
      color: #f8690d !important;
    }

    .error {
      color: red !important;
    }

    .w-40px {
      width: 40px;
    }

    .fileUploaded {
      display: none;
    }

    .uploadDelete {
      margin-left: 5px;
    }

    .viewUpload {
      background: greenyellow;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .type-sec .nav-link.active {
      color: #282422;
      text-transform: uppercase;
      background: orange;
    }

    .a9s-toolbar {
      position: absolute;
      top: 30px;
      left: 10px;
    }

    .a9s-toolbar-btn {
      margin: 4px 4px 4px 0;
      outline: 1px;
      cursor: pointer !important;
      background-color: #f8f9fa;
      border-radius: 4px;
      padding: 4px;
      width: 32px;
      height: 32px;
      border-radius: 16px;
    }

    .a9s-toolbar-btn:hover {
      margin: 4px 4px 4px 0;
      outline: 1px;
      cursor: pointer !important;
      background-color: #f0cd76;
      border-radius: 4px;
      padding: 4px;
      width: 32px;
      height: 32px;
      border-radius: 16px;
    }

    .a9s-annotation .a9s-inner,
    .a9s-selection .a9s-inner {
      stroke: #fbfbfb;
      stroke-width: 1px;
      fill: rgb(13 248 45 / 10%);
    }

    .sayfa-isaretle-grid {
      display: grid;
      gap: 15px;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      margin-bottom: 30px;
      padding-inline: 30px;
    }

    .sayfa-isaretle-grid .custom-check {
      position: relative;
      cursor: pointer;
    }

    .sayfa-isaretle-grid .custom-check>[type=checkbox] {
      display: none;
    }

    .sayfa-isaretle-grid .custom-check>[type=checkbox]+span {
      display: block;
    }

    .sayfa-isaretle-grid .sayfa-isaretle {
      text-align: center;
    }

    .sayfa-isaretle-grid .sayfa-isaretle .sayfa-isaretle-card {
      border: 2px solid #ebebeb;
      border-radius: 10px;
      background-color: #fff;
      font-size: 14px;
      color: #7f7f7f;
      padding: 15px;
      margin-bottom: 10px;
    }

    .sayfa-isaretle-grid .sayfa-isaretle__dosya {
      font-weight: 600;
      color: #222;
      margin-bottom: 5px;
      font-size: 15px;
    }

    .sayfa-isaretle-grid .sayfa-isaretle__text {
      line-height: 1.1;
      text-align: left;
      color: #999;
    }

    .sayfa-isaretle-grid .sayfa-isaretle-pseudo-btn {
      background-color: #c3c3c3;
      color: #fff;
      border-radius: 8px;
      padding: 5px 20px;
    }

    .sayfa-isaretle-grid .custom-check>[type=checkbox]:checked+span .sayfa-isaretle-card {
      border-color: #eebc34;
    }

    .sayfa-isaretle-grid .custom-check>[type=checkbox]:checked+span .sayfa-isaretle-pseudo-btn {
      background-color: #eebc34;
    }

    .sayfa-isaretle-grid .custom-check>[type=checkbox][disabled]+span {
      background: #f00;
    }

    .full_modal-dialog {
      width: 98% !important;
      height: 92% !important;
      min-width: 98% !important;
      min-height: 92% !important;
      max-width: 98% !important;
      max-height: 92% !important;
      padding: 0 !important;
    }

    .full_modal-content {
      height: 99% !important;
      min-height: 99% !important;
      max-height: 99% !important;
      padding: 20px;
    }

    .md-input-preview {
      width: 100%;
      height: 100%;
      min-height: 300px;
      height: -webkit-fill-available !important;
    }

    .md-input-preview tbody tr {
      width: 100%;
      height: 100%;
      min-height: 300px;
      height: -webkit-fill-available !important;
    }

    .md-preview-cell {
      min-height: 300px;
      height: -webkit-fill-available !important;
    }

    .md-input-cell {
      min-height: 300px;
      height: -webkit-fill-available !important;
    }

    .md-preview-cell .md-preview {
      width: 100%;
      min-height: 300px;
      height: -webkit-fill-available !important;
    }

    .navKulucka {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
    }

    #navKuluckaCurrent {
      margin-left: 20px;
      margin-right: 20px;
      padding: 2px 0;
      color: #222;
      font-size: 14px;
      text-transform: uppercase;
    }
    .pac-container {
      z-index: 200000;
    }
  </style>
  <%- contentFor('body') %>
    <header>
      <%- include('partials/menu'); -%>
    </header>
    <main role="main">
      <section class="degrade-desen-bg">
        <div class="container">
          <div class="row py-5">
            <div class="col-sm-20 col-md-16 col-lg-14 col-xl-12 mx-auto">
              <div class="cozumleyici-nedir">
                <h1>Eklediğiniz Kelimeler Listesi</h1>
                <p>Seti teslim ettikten sonra düzenleme için geri dönmeniz mümkün değildir. Eklediğiniz kelimeleri
                  görmek ve düzenleme yapmak için 'DÜZELTME'ye tıklayınız. Yaptığınız çeviride eksik veya hata
                  bulunduğunu düşünüyorsanız telegram topluluğumuzdan destek alabilirsiniz.</p>
              </div>
            </div>
          </div>
        </div>
        </div>
      </section>
      <section class="standard-padding">
        <div class="container">
          <table id="kuluckam" class="table table-striped table-bordered" style="width:100%;">
            <thead>
              <tr>
                <th style="min-width:20%;">Maddebaşı</th>
                <th style="min-width:20%;">Diğer yazım</th>
                <th style="min-width:20%;">Karşı maddebaşı</th>
                <th style="min-width:20%;">Tür</th>
                <th style="min-width:20%;">İşlemler</th>
              </tr>
            </thead>
          </table>
          <div class="col-20 col-md d-flex flex-0 justify-content-center mb-5">
            <% if (user && user.canDoKulucka && !user.canDoKuluckaModerate) { %>
            <button id="teslimEt" class="btn btn-primary px-3">SET'TEKİ TÜM MADDEBAŞLARININ GİRİŞİNİ YAPTIM VE EKLEDİKLERİMİ GÖZDEN
              GEÇİRDİM <br /> TESLİM ET</button>
              <% } else if (user && user.canDoKuluckaModerate) { %>
                <button id="kontrolEttim" class="btn btn-primary px-3">SET'TEKİ TÜM MADDEBAŞLARININ GİRİŞİNİ KONTROL ETTİM <br /> SETİ SONLANDIR</button>
              <% } %>
          </div>
        </div>
      </section>
      <%- include('partials/profile-sidenav'); -%>
    </main>

    <%- contentFor('footerBlock') %>
      <!-- Maddebaşı düzenleme Modal -->
      <div class="modal fade" tabindex="-1" id="formUpdate">
        <div class="modal-dialog modal-dialog-scrollable full_modal-dialog">
          <div class="modal-content full_modal-content">
            <div class="modal-header">
              <h5 class="modal-title mx-auto navKulucka">
                <button id="navKuluckaPrev" class="btn btn-primary">← Önceki</button>
                <div id="navKuluckaCurrent"></div><button id="navKuluckaNext" class="btn btn-primary">Sonraki →</button>
              </h5>
              <button type="button" class="close" data-dismiss="modal" aria-label="Kapat">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
            <div class="modal-body">
              <div class="row">
                <div class="col-sm-8 my-4">
                  <div class="sayfa-izleme">
                    <!-- The toolbar mounts itself into a DIV on your page -->
                    <div id="my-toolbar-container"></div>
                    <div id="openseadragon1" style="width: 100%; height: 700px;background-color: #282422;"></div>
                    <div id="sonrakiSetYukle" class="btn btn-light buton-border-gri my-3">Sadece yarım kalan set sonu
                      maddebaşların devamını görmek için tıklayınız. Önemli Not: Burdan yeni madde başları
                      girilmicektir.</a>
                    </div>
                  </div>
                </div>
                <div class="col-sm-12">
                  <section class="type-sec">
                    <div class="container ">
                      <div class="row hidden-mobile">
                        <div class="col mt-5">
                          <!-- sections/_sozlukler.scss -->
                          <ul class="nav justify-content-center nav-tabs sozluk-tab-linkler" id="selectTab">
                            <li class="nav-item">
                              <a class="nav-link active" id="kelime-tab" data-toggle="tab" data-tip="kelime"
                                href="#sendeekleform"><%- __('word') %></a>
                            </li>
                            <li class="nav-item">
                              <a class="nav-link" id="tamlama-tab" data-toggle="tab" data-tip="tamlama"
                                href="#sendeekleform"><%- __('noun') %></a>
                            </li>
                            <li class="nav-item">
                              <a class="nav-link" id="cumle-tab" data-toggle="tab" data-tip="kalıp"
                                href="#sendeekleform"><%- __('pattern') %></a>
                            </li>
                            <li class="nav-item">
                              <a class="nav-link" id="atasozu-tab" data-toggle="tab" data-tip="atasözü"
                                href="#sendeekleform"><%- __('proverb') %></a>
                            </li>
                            <li class="nav-item">
                              <a class="nav-link" id="deyim-tab" data-toggle="tab" data-tip="deyim"
                                href="#sendeekleform"><%- __('expression') %></a>
                            </li>
                            <li class="nav-item">
                              <a class="nav-link" id="kisi-tab" data-toggle="tab" data-tip="kişi"
                                href="#sendeekleform"><%- __('person') %></a>
                            </li>
                            <li class="nav-item">
                              <a class="nav-link" id="eser-tab" data-toggle="tab" data-tip="eser"
                                href="#sendeekleform"><%- __('work') %></a>
                            </li>
                            <li class="nav-item">
                              <a class="nav-link" id="olay-tab" data-toggle="tab" data-tip="olay"
                                href="#sendeekleform"><%- __('event') %></a>
                            </li>
                            <li class="nav-item">
                              <a class="nav-link" id="yapi-tab" data-toggle="tab" data-tip="yapı"
                                href="#sendeekleform"><%- __('structure') %></a>
                            </li>
                            <li class="nav-item">
                              <a class="nav-link" id="yeradi-tab" data-toggle="tab" data-tip="yeradı"
                                href="#sendeekleform"><%- __('placename') %></a>
                            </li>
                            <li class="nav-item">
                              <a class="nav-link" id="soz-tab" data-toggle="tab" data-tip="söz"
                                href="#sendeekleform"><%- __('utterance') %></a>
                            </li>
                          </ul>
                          <!-- sections/_sozlukler.scss -->
                        </div>
                      </div>
                    </div>
                  </section>
                  <section class="pt-1">
                    <div class="container">
                      <div class="tab-content sozluk-tab-icerikler">
                        <!-- KELİME TAB -->
                        <div class="tab-pane fade show active" id="sendeekleformtab">
                          <div class="row">
                            <div class="col-lg-16 col-md-20 mx-auto mb-4">
                              <p class="text-center">Lütfen girilen madde için uygun sekmeyi seçiniz. Doğru ekleme yapmak için Madde Nasıl Eklenir? videosunu izleyiniz. Önemli: Sözlükte yer alan kısaltmalar için
                                <a href="<%=dictionary.kisaltmalarUrl%>" target="_blank">tıklayınız</a>.
                                <br><span class="text-danger">Not:
                                  Sadece * (yıldız) işaretli olan yerler zorunludur.</span>
                              </p>
                              <button class="btn btn-text" id="smart-keyboard-toggle"><i class="fas fa-keyboard">Klavye</i></button>
                            </div>
                          </div>
                          <div class="row">
                            <div class="col-lg-16 col-md-20 mx-auto mb-4">
                              <form id="sendeekleform" class="moderator-form">
                                <div class="flex-sira mb-md-1">
                                  <div class="zorunlu-yildiz form-group w-25">
                                    <label for="dil">Dili</label>
                                    <select name="dil"
                                      class="dilSecimi custom-select custom-select bg-primary text-white parca-auto-width">
                                      <option value="">Seçiniz</option>
                                    </select>
                                  </div>
                                  <div class="zorunlu-yildiz form-group w-50">
                                    <label for="madde">Eklenecek maddebaşı</label>
                                    <input type="text" name="madde" id="maddeInput"
                                      class="form-control flex-grow-2 parca" placeholder="Örn: hakim">
                                    <input type="hidden" name="tip" id="tipInputField">
                                    <input type="hidden" name="id" id="recordId">
                                    <input type="hidden" name="dictId" value="<%=selectedSet.dictId.id%>">
                                    <input type="hidden" name="kuluckaSectionId" value="<%=selectedSet.id%>">
                                    <input type="hidden" name="userSubmitted" value="">
                                  </div>
                                  <div class="form-group d-flex flex-column w-25">
                                    <label for="sesDosyasi" class="mt-2">Ses Ekle</label>
                                    <a href="#" class="openfileUpload btn btn-light buton-border-gri"
                                      data-name="sesDosyasi" data-accept="audio/*, *.mp3, *.wav" data-toggle="modal" data-accept="audio/*, *.mp3, *.wav" data-target="#fileUpload"><i
                                        class="fas fa-volume-down mr-2"></i>Yükle</a>
                                    <input type="hidden" data-name="sesDosyasi" name="sesDosyasi" class="sesDosyasi">
                                  </div>
                                  <div class="digeryazimSection no-yildiz form-group w-auto">
                                    <label for="digeryazim">Diğer yazım şekli</label>
                                    <select name="digeryazim" multiple="multiple"
                                      class="digerInput form-control flex-grow-2 parca" placeholder="Örn: hâkim">
                                    </select>
                                  </div>
                                  <div class="sozSection no-yildiz form-group w-auto">
                                    <label for="sozusoyleyen">Sözü Söyleyen Kişi</label>
                                    <input type="text" name="sozusoyleyen" class="form-control  flex-grow-2 parca"
                                      placeholder="Örn: Fatih Sultan Mehmet">
                                  </div>
                                </div>

                                <div class="karsidilSection flex-sira mb-md-1">
                                  <div class="form-group w-25">
                                    <label for="exampleInputEmail1">Karşı Dili</label>
                                    <select name="karsidil"
                                      class="dilSecimi custom-select custom-select bg-primary text-white parca-auto-width">
                                      <option value="">Seçiniz</option>
                                    </select>
                                  </div>
                                  <div class="form-group w-50">
                                    <label for="exampleInputEmail1">Eklenecek maddebaşı</label>
                                    <input type="text" name="karsimadde" class="form-control flex-grow-2 parca"
                                      placeholder="Örn: hakim">
                                  </div>
                                  <div class="form-group d-flex flex-column w-25">
                                    <label for="exampleInputEmail1">Ses Ekle</label>
                                    <% var initialkarsisesDosyasiID=Math.floor(Math.random() * 26) + Date.now(); %>
                                      <a href="#" class="openfileUpload btn btn-light buton-border-gri"
                                        data-toggle="modal" data-accept="audio/*, *.mp3, *.wav" data-name="<%=initialkarsisesDosyasiID%>"
                                        data-target="#fileUpload"><i class="fas fa-volume-down mr-2"></i>Yükle</a>
                                      <input type="hidden" data-name="<%=initialkarsisesDosyasiID%>"
                                        name="karsisesDosyasi" class="sesDosyasi">
                                  </div>
                                  <div class="form-group w-auto">
                                    <label for="exampleInputEmail1">Diğer yazım şekli</label>
                                    <select name="karsidigeryazim" multiple="multiple"
                                      class="digerInput form-control flex-grow-2 parca" placeholder="Örn: hâkim">
                                    </select>
                                  </div>
                                  <div class="form-group align-items-end d-flex form-group">
                                    <a id="karsiDilEkle" class="btn btn-light buton-border-gri w-40px"><i
                                        class="fas fa-plus mr-2"></i></a>
                                  </div>
                                </div>

                                <div class="eserSection flex-sira mb-md-1 w-100">
                                  <div class="form-group w-auto">
                                    <label for="eserindili">Eserin Dili</label>
                                    <input type="text" name="eserindili" class="form-control flex-grow-2 parca"
                                      placeholder="Osmanlıca">
                                  </div>
                                  <div class="form-group w-25">
                                    <label for="eserindonemi">Eserin Dönemi</label>
                                    <input type="text" name="eserindonemi" class="form-control flex-grow-2 parca"
                                      placeholder="Ör: Osmanlı dönemi">
                                  </div>
                                  <div class="form-group w-25">
                                    <label for="eserinyili">Eserin Yılı</label>
                                    <input type="text" name="eserinyili" class="form-control flex-grow-2 parca"
                                      placeholder="Ör: 1876">
                                  </div>
                                  <div class="form-group w-25">
                                    <label for="eserinyazari">Eserin Yazarı</label>
                                    <input type="text" name="eserinyazari" class="form-control flex-grow-2 parca"
                                      placeholder="Ör: Ahmet Hamdi">
                                  </div>
                                </div>

                                <div class="flex-sira  mb-md-3">
                                  <div class="zorunlu-yildiz form-group w-100" style="width: 100%; min-height: 300px;">
                                    <label for="exampleInputEmail1">Anlamı-Maddebaşı içeriği</label>
                                    <textarea class="form-control w-100 h-100"
                                      placeholder="1. Mümtâz adam, feylesof. {mecaz} &#10;2. Felsefe mütehassısı. {felsefe} &#10;3. "
                                      id="editor-id" name="anlam" rows="15"></textarea>
                                  </div>
                                </div>

                                <div class="sozSection flex-sira mb-md-1 w-100 h-100">
                                  <div class="karsianlamAc form-group w-100">
                                    <div class="btn btn-light buton-border-gri py-4 w-100">KARŞI DİLDE ANLAM İÇERİĞİ
                                      EKLEMEK İÇİN TIKLAYIN</div>
                                  </div>
                                  <div class="karsiEditor form-group w-100 h-100"
                                    style="width: 100%; min-height: 300px;">
                                    <label for="exampleInputEmail1">Karşı dil anlamı-maddebaşı içeriği</label>
                                    <textarea class="form-control w-100 h-100"
                                      placeholder="1. Mümtâz adam, feylesof. {mecaz} &#10;2. Felsefe mütehassısı. {felsefe} &#10;3. "
                                      id="karsieditor-id" name="karsianlam" rows="15"></textarea>
                                  </div>
                                </div>

                                <div class="sekilSection flex-sira mb-md-1 w-100">
                                  <div class="form-group w-25">
                                    <label
                                      class="sekilSecimi custom-select custom-select bg-primary text-white parca-auto-width">
                                      Şekil 1
                                    </label>
                                  </div>
                                  <div class="form-group w-100">
                                    <input type="text" name="sekilaciklama" class="form-control flex-grow-2 parca"
                                      placeholder="Şekil ile ilgili açıklamaları buraya giriniz">
                                  </div>
                                  <div class="form-group d-flex flex-column w-25">
                                    <% var initialsekilresimID=Math.floor(Math.random() * 26) + Date.now(); %>
                                      <a href="#" class="openfileUpload btn btn-light buton-border-gri"
                                        data-toggle="modal" data-accept="image/*" data-name="<%=initialsekilresimID%>"
                                        data-target="#fileUpload"><i class="fas fa-image mr-2"></i>Yükle</a>
                                      <input type="hidden" data-name="<%=initialsekilresimID%>" name="sekilresim">
                                  </div>
                                  <div class="form-group align-items-start d-flex form-group">
                                    <a id="sekilEkle" class="btn btn-light buton-border-gri w-40px"><i
                                        class="fas fa-plus mr-2"></i></a>
                                  </div>
                                </div>

                                <div class="kokleriSection flex-sira mb-md-1 w-100">
                                  <div class="form-group w-100">
