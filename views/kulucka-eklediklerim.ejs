          } else {
            $('#kontrolEttim').prop('disabled', true);
            $('#teslimEt').prop('disabled', true);
          }
          var table = $('#kuluckam').DataTable({
            responsive: true,
            searching: false,
            ordering: false,
            data: kuluckalarim,
            columns: [
              { data: 'madde' },
              {
                data: 'digeryazim',
                "render": function (data, type, row, meta) {
                  return data ? data : '-';
                },
              },
              {
                data: 'whichDict.karsi.0.madde',
                "render": function (data, type, row, meta) {
                  return data ? data : '-';
                },
              },
              {
                data: 'whichDict.tip.0',
                "render": function (data, type, row, meta) {
                  return data ? data : '-';
                },
              },
              {
                targets: -1,
                data: null,
                defaultContent: '<button class="silbeni btn btn-danger btn-sm mr-3">SİL</button><button class="duzenlebeni btn btn-info btn-sm">DÜZENLE</button>',
              }
            ],
            language: {
              url: 'https://cdn.datatables.net/plug-ins/1.11.5/i18n/tr.json',
            }
          });

          $('#kuluckam tbody').on('click', 'button.silbeni', function () {
            var data = table.row($(this).parents('tr')).data();
            Swal.fire({
              title: 'Silmek istediğinizden emin misiniz?',
              icon: 'danger',
              confirmButtonText: 'Evet',
              cancelButtonText: 'Hayır',
              showCancelButton: true,
            }).then((result) => {
              if (result['isConfirmed']) {
                $.ajax({
                  url: `/kulucka-sil/${data._id}`,
                  method: "post",
                  success: function (response) {
                    Swal.fire({
                      title: "Silindi!",
                      text: response,
                      icon: "success",
                      heightAuto: false,
                    });
                    setTimeout(() => window.location.reload(), 900);
                  },
                  error: function (err) {
                    Swal.fire({
                      title: "Hata!",
                      text: err.responseJSON.message,
                      icon: "error",
                      confirmButtonText: "ok",
                      heightAuto: false,
                    });
                  },
                });
              }
            })
          });

          $('#kuluckam tbody').on('click', 'button.duzenlebeni', function () {
            var data = table.row($(this).parents('tr')).data();
            loadedIndex = kuluckalarim.findIndex((kulucka) => kulucka.whichDict._id === data.whichDict._id);
            $('#formUpdate').modal('toggle');
            setTimeout(function () {
              updateSendeEkleForm(data);
            }, 400);
          });

          let aktifDiller = await getAktifDiller('array');

          $(document).on("click", ".openfileUpload", function () {
            var inputName = $(this).data('name');
            var inputAccept = $(this).data('accept');
            $("#inputToBeUploaded").val(inputName);
            $("#thefiles").data('fancy-fileupload').form.find('input[type=file]').attr('accept', inputAccept);
          });

          $(document).on("click", ".uploadDelete", function () {
            var inputName = $(this).data('name');
            $(`input[data-name='${inputName}']`).val(null).trigger('change');
            $(`a[data-name='${inputName}']`).removeClass('fileUploaded');
            $(`.viewUpload[data-name='${inputName}']`).remove();
            $(`a[data-name='${inputName}']`).html(`<i class="fas fa-volume-down mr-2"></i>Yükle`);
            $(this).remove();
          });

          $(document).on('click', '.karsiDilSil', function () {
            const silId = $(this).attr('data-id');
            console.log('silID:', silId);
