      <script type="text/javascript">
        $(function () {
          $('#thefiles').FancyFileUpload({
            maxfilesize : 52428800,
            edit: false,
            added : function(e, data) {
              var pos = data.files[0].name.lastIndexOf('.');
              var filename = (pos > -1 ? data.files[0].name.substring(0, pos) : data.files[0].name);
              var fileext = (pos > -1 ? data.files[0].name.substring(pos + 1).toLowerCase() : '');
              if (!fileext.includes('.')) fileext = '.' + fileext
              var acceptions = e.target.accept.split(",").map(function(item) {
                return item.trim();
              });
              var found = false;
              for (var x = 0; x < acceptions.length && !found; x++)
              {
                if (acceptions[x] === fileext || acceptions[x] === data.files[0].type || data.files[0].type.match(acceptions[x])?.length > 0)  found = true;
              }

              if (!found)  {
                data.ff_info.errors.push('Invalid file extension.');
                this.find('.ff_fileupload_errors').html(data.ff_info.errors.join('<br>')).removeClass('ff_fileupload_hidden');
                this.find('button.ff_fileupload_start_upload').remove();
              } else {
                    // It is okay to simulate clicking the start upload button.
                    this.find('.ff_fileupload_actions button.ff_fileupload_start_upload').click();
              }
            },
            uploadcompleted: function (e, data) {
              if (data.result.url) {
                const toupdateinput = $("#inputToBeUploaded").val();
                $(`input[data-name='${toupdateinput}']`).val(data.result.url);
                $(`a[data-name='${toupdateinput}']`).addClass('fileUploaded');
                $(`<div class="viewUpload btn btn-light" data-name="${toupdateinput}"><a href="#" data-name="${toupdateinput}" class="uploadDelete ma-auto">🗑️</a><a href="${data.result.url}" target="_blank" class="ma-auto">🔗</a></div>`).insertAfter(`a[data-name='${toupdateinput}']`);
                data.ff_info.RemoveFile();
                $('#fileUpload').modal('toggle');
              }
            },
          });
        });
      </script>
