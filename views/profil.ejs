<%- contentFor('headerBlock') %>
<link href="assets/css/style.css" rel="stylesheet" />

<%- contentFor('body') %>
<header class="mb-0"><%- include('partials/menu'); -%>

  <div class="container-fluid degrade-desen-bg">
    <div class="row">
      <div class="col-md-18 col-lg-14 col-xl-12 mx-auto">
          <div class="profil-bar-ust">
            <div class="row">
              <div class="col-20 col-md-5 mb-2 mb-lg-1">
                <a href="#" class="avatar-link"><img src="<%= user.picture %>" class="img-fluid profil-avatar"></a>
              </div>
              <div class="col-20 col-md-15">
                <div class="profil-bilgiler pt-lg-2">
                  <div class="profil-bilgiler__isim mb-2">
                    <span class="mr-md-3 profil-isim order-2 order-md-1">@<%= user.nickname %></span>
                    <span class="order-1 order-md-2 takip-sosyal-wrapper">
                      <a href="javascript:void();" id="followButton" class="takip-btn">Takip Et</a>
                      <a href="javascript:void();" id="followButton" class="takip-btn">Takibi bırak</a>
                      <span class="takip-sosyal">
                        <% if (user && user.facebook) { %><a href="https://facebook.com/<%= user.facebook %>" target="_blank" class="mr-1"><i class="fab fa-facebook-f"></i></a> <% } %>
                        <% if (user && user.twitter) { %><a href="https://twitter.com/<%= user.twitter %>" target="_blank" class="mr-1"><i class="fab fa-twitter"></i></a><% } %>
                        <% if (user && user.instagram) { %><a href="https://instagram.com/<%= user.instagram %>" target="_blank" class="mr-1"><i class="fab fa-instagram"></i></a><% } %>
                        <% if (user && user.linkedin) { %><a href="https://linkedin.com/<%= user.linkedin %>" target="_blank" class="mr-1"><i class="fab fa-linkedin-in"></i></a><% } %>
                      </span>
                    </span>
                  </div>
                  <div class="profil-bilgiler__biyografi">
                    <%= user && user.profileMessage ? user.profileMessage : '' %>
                  </div>
                </div>
              </div>
            </div>
          </div>
      </div>
    </div>
  </div>
  <div class="container-fluid profil-rakamlar">
    <div class="row">
      <div class="col-md-18 col-lg-14 col-xl-12 mx-auto">
        <div class="nav profil-rakamlar__kutu">
          <a href="#profile-duvar" class="text-center active" data-toggle="tab">
            <p>duvar</p>
            <p class="bold" id="profile-duvar-stat"></p>
          </a>
          <a href="#profile-likes" class="text-center" data-toggle="tab">
            <p>beğeni</p>
            <p class="bold" id="profile-likes-stat"></p>
          </a>
          <a href="#profile-favorites" class="text-center" data-toggle="tab">
            <p>favori</p>
            <p class="bold" id="profile-favorites-stat"></p>
          </a>
          <a href="#profile-followers" class="text-center" data-toggle="tab">
            <p>takipçi</p>
            <p class="bold"><%- (stats && stats.followers) ? stats.followers : '0' %></p>
          </a>
          <a href="#profile-followings" class="text-center" data-toggle="tab">
            <p>takip ed.</p>
            <p class="bold"><%- (stats && stats.follows) ? stats.follows : '0' %></p>
          </a>
          <a href="#profile-eklenen" class="text-center" data-toggle="tab">
            <p>eklenilen</p>
            <p class="bold"><%- (stats && stats.madde) ? stats.madde : '0' %></p>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>
