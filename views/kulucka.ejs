<%- contentFor('headerBlock') %>
<link href="/assets/css/style.css" rel="stylesheet">
<style type="text/css">
    /* Arrows */
.slick-prev,
.slick-next
{
    font-size: 0;
    line-height: 0;

    position: absolute;
    top: 50%;

    display: block;

    width: 20px;
    height: 20px;
    padding: 0;
    -webkit-transform: translate(0, -50%);
    -ms-transform: translate(0, -50%);
    transform: translate(0, -50%);

    cursor: pointer;

    color: transparent;
    border: none;
    outline: none;
    background: transparent;
}
.slick-prev:hover,
.slick-prev:focus,
.slick-next:hover,
.slick-next:focus
{
    color: transparent;
    outline: none;
    background: transparent;
}
.slick-prev:hover:before,
.slick-prev:focus:before,
.slick-next:hover:before,
.slick-next:focus:before
{
    opacity: 1;
}
.slick-prev.slick-disabled:before,
.slick-next.slick-disabled:before
{
    opacity: .25;
}

.slick-prev:before,
.slick-next:before
{
    font-family: 'slick';
    font-size: 20px;
    line-height: 1;

    opacity: .75;
    color: white;

    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

.slick-prev
{
    left: -25px;
}
[dir='rtl'] .slick-prev
{
    right: -25px;
    left: auto;
}
.slick-prev:before
{
    content: '←';
}
[dir='rtl'] .slick-prev:before
{
    content: '→';
}

.slick-next
{
    right: -25px;
}
[dir='rtl'] .slick-next
{
    right: auto;
    left: -25px;
}
.slick-next:before
{
    content: '→';
}
[dir='rtl'] .slick-next:before
{
    content: '←';
}

/* Dots */
.slick-dotted.slick-slider
{
    margin-bottom: 30px;
}

.slick-dots
{
    position: absolute;
    bottom: -25px;

    display: block;

    width: 100%;
    padding: 0;
    margin: 0;

    list-style: none;

    text-align: center;
}
.slick-dots li
{
    position: relative;

    display: inline-block;

    width: 20px;
    height: 20px;
    margin: 0 5px;
    padding: 0;

    cursor: pointer;
}
.slick-dots li button
{
    font-size: 0;
    line-height: 0;

    display: block;

    width: 20px;
    height: 20px;
    padding: 5px;

    cursor: pointer;

    color: transparent;
    border: 0;
    outline: none;
    background: transparent;
}
.slick-dots li button:hover,
.slick-dots li button:focus
{
    outline: none;
}
.slick-dots li button:hover:before,
.slick-dots li button:focus:before
{
    opacity: 1;
}
.slick-dots li button:before
{
    font-family: 'slick';
    font-size: 6px;
    line-height: 20px;

    position: absolute;
    top: 0;
    left: 0;

    width: 20px;
    height: 20px;

    content: '•';
    text-align: center;

    opacity: .25;
    color: black;

    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}
.slick-dots li.slick-active button:before
{
    opacity: .75;
    color: black;
}

    /* Slider */
.slick-slider
{
    position: relative;

    display: block;
    box-sizing: border-box;

    -webkit-user-select: none;
       -moz-user-select: none;
        -ms-user-select: none;
            user-select: none;

    -webkit-touch-callout: none;
    -khtml-user-select: none;
    -ms-touch-action: pan-y;
        touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
}

.slick-list
{
    position: relative;

    display: block;
    overflow: hidden;

    margin: 0;
    padding: 0;
}
.slick-list:focus
{
    outline: none;
}
.slick-list.dragging
{
    cursor: pointer;
    cursor: hand;
}

.slick-slider .slick-track,
.slick-slider .slick-list
{
    -webkit-transform: translate3d(0, 0, 0);
       -moz-transform: translate3d(0, 0, 0);
        -ms-transform: translate3d(0, 0, 0);
         -o-transform: translate3d(0, 0, 0);
            transform: translate3d(0, 0, 0);
}

.slick-track
{
    position: relative;
    top: 0;
    left: 0;

    display: block;
    margin-left: initial;
    margin-right: initial;
}
.slick-track:before,
.slick-track:after
{
    display: table;

    content: '';
}
.slick-track:after
{
    clear: both;
}
.slick-loading .slick-track
{
    visibility: hidden;
}

.slick-slide
{
    display: none;
    float: left;

    height: 100%;
    min-height: 1px;
    min-width: 200px;
}
[dir='rtl'] .slick-slide
{
    float: right;
}
.slick-slide img
{
    display: block;
}
.slick-slide.slick-loading img
{
    display: none;
}
.slick-slide.dragging img
{
    pointer-events: none;
}
.slick-initialized .slick-slide
{
    display: block;
}
.slick-loading .slick-slide
{
    visibility: hidden;
}
.slick-vertical .slick-slide
{
    display: block;

    height: auto;

    border: 1px solid transparent;
}
.slick-arrow.slick-hidden {
    display: none;
}
.kulucka-asama-title {
  display: flex;
  align-items: center;
  margin-bottom: 30px;
}
@media (max-width: 767px) {
  .kulucka-asama-title {
    flex-direction: column;
    align-items: flex-start;
  }
}
.kulucka-asama-title .yumurta {
  width: 70px;
  height: 70px;
  background-color: #f57e17;
  border-radius: 50%;
  display: grid;
  place-items: center;
  margin-right: 15px;
}
.kulucka-asama-title .yumurta img {
  height: 40px;
}

.yumurta-text__title {
  color: #000;
  font-size: 20px;
}

.yumurta-text__sub-title {
  color: #bbb;
  font-size: 16px;
  line-height: 1;
}

.kulucka-slider {
  position: relative;
  overflow-x: hidden;
  /* the parent */
}
.kulucka-slider::after {
  content: "";
  position: absolute;
  display: inline-block;
  right: 0;
  top: 0;
  bottom: 0;
  height: 100%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, white 100%);
  width: 60px;
  pointer-events: none;
}
.kulucka-slider .slick-slide {
  margin: 0 10px;
}
.kulucka-slider .slick-list {
  margin: 0 -10px;
}
.kulucka-slider .sozluk-duzelt-card {
  padding: 20px;
}
.kulucka-slider .sozluk-duzelt-card h5, .kulucka-slider .sozluk-duzelt-card h6 {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    max-width: 200px;
    -webkit-line-clamp: 2;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    white-space: normal;
}
.kulucka-slider .sozluk-duzelt-card h6 {
  font-size: 13px;
}
.kulucka-slider .sozluk-duzelt-card .sozluk-duzelt-card__header-img {
  width: 50px !important;
  height: 50px !important;
  margin-right: 10px !important;
}
.kulucka-slider .sozluk-duzelt-card .sozluk-duzelt-card__header-yazilar {
  min-width: 0;
}

[class^=kulucka-slider__nav] {
  position: relative;
  width: 20px;
  margin-left: 40px;
}
[class^=kulucka-slider__nav] button {
  opacity: 1;
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  background-color: #f57e17;
  border-radius: 50%;
}
[class^=kulucka-slider__nav] button:hover {
  cursor: pointer;
  opacity: 1;
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  background-color: #f57e17;
  border-radius: 50%;
}
[class^=kulucka-slider__nav] button::before {
  color: #fff;
  opacity: 1 !important;
  font-size: 30px;
  font-family: "Font Awesome 5 Free";
  font-weight: 900;
}
[class^=kulucka-slider__nav] .slick-prev::before {
  content: "\f104";
}
[class^=kulucka-slider__nav] .slick-next::before {
  content: "\f105";
}

.kulucka-tab-nav {
  justify-content: space-between;
}
.kulucka-tab-nav > a {
  flex-grow: 1;
  text-align: center;
}
</style>
