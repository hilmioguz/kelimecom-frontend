            $(`select[name="dil"]`).val('<%=dictionary.lang%>');
            $(`select[name="karsidil"]`).val('<%=dictionary.karsilang%>');
          }

          const multiselects = ['.digerInput', '.kokleriInput', '.kokenDiliInput', '.turInput', '.altturInput', '.kokenInput', '.cinsiyetInput', '.sinifiInput', '.transkripsiyonInput', '.fonetikInput', '.heceliyazimInput', '.zitanlamInput', '.esanlamInput', '.bicimInput'];
          multiselects.forEach(element => {
            $(element).select2({
              placeholder: "Seç ya da yeni ekle",
              tags: true,
              tokenSeparators: [',']
            });
          });


          $.validator.setDefaults({
          ignore: [],
          });

          $.validator.addMethod("karsidilRule", function (value, element) {
              var karsimaddeFlag = [];
              var karsidilFlag = [];
              $("input[name='karsimadde']").each(function(){
                if ($(this).val()) {
                  karsimaddeFlag.push(true);
                } else {
                  karsimaddeFlag.push(false);
                }
              });
             $("select[name='karsidil']").each(function(){
                if ($(this).val()) {
                  karsidilFlag.push(true);
                } else {
                  karsidilFlag.push(false);
                }
              });
              // console.log('karsimaddeFlag:', !karsimaddeFlag.includes(false), 'karsidilFlag:', karsidilFlag.includes(false));
              if (!karsimaddeFlag.includes(false) && karsidilFlag.includes(false)) {
                return false;
              } else {
                return true;
              }
          }, siteLang === 'en' ? "This field is required!":"Bu alan zorunlu!");

          $.validator.addMethod("bulunduguSayfalarRule", function (value, element) {
            if (!value || value.length === 0 || value == 'undefined' || value === null || value === '[]') {
              return false;
            } else {
              return true;
            }
          }, siteLang === 'en' ? "This field is required!":"Bu alan zorunlu!");

          $("#sendeekleform").validate({
            ignore: '.select2-input, .select2-focusser',
            rules: {
              anlam: {
                required: true,
              },
              madde: {
                required: true,
              },
              dil: {
                required: true,
              },
              "karsidil": {
                karsidilRule: true,
              },
              bulunduguSayfalar: {
                bulunduguSayfalarRule: true,
              }
            },
            messages: {
              anlam: {
                required: siteLang === 'en' ? "This field is required!":"Bu alan zorunlu!",
              },
              madde: {
                required: siteLang === 'en' ? "This field is required!":"Bu alan zorunlu!",
              },
              dil: {
                required: siteLang === 'en' ? "This field is required!":"Bu alan zorunlu!",
              },
              bulunduguSayfalar: {
                required: siteLang === 'en' ? "This field is required!":"Bu alan zorunlu!",
              }
            },
          });

          $("#sendekaydet").on("click", function () {
            const bmaparray = Array.from(bulunduguMap, ([url, annotation]) => {
              if (annotation != '[]') return ({ url, annotation });
            });
            if (bmaparray && bmaparray.length > 0) {
              const filtered = bmaparray.filter(Boolean);
              $('#bulunduguSayfalar').val(JSON.stringify(filtered));
            }
            var karsidigeryazimPost = [];
            $('select[name="karsidigeryazim"]').each(function() {
              const val = $(this).val();
              karsidigeryazimPost.push({name: 'karsidigeryazim', value: val.join(',')});
            });

            const isvalid = $("#sendeekleform").valid();
            var post_vars = $('form#sendeekleform').serializeArray();
            // console.log('postvars:', post_vars);
            const found = post_vars.filter((v)=> v.name !== 'karsidigeryazim');
            const payload = found.concat(karsidigeryazimPost);
            if (isvalid) {
              const self = this;
              $(this).prop("disabled", true);
              $(this).html('<i class="fa fa-spinner fa-spin fa-lg fa-fw"></i>');
              setTimeout(() => {
                $(this).html("KAYDET");
              }, 1000);
              $.ajax({
                url: "/kulucka-ekle",
                method: "post",
                data: payload,
                success: function (response) {
                  anno.clearAnnotations();
                  Swal.fire({
                      title: "Ok!",
                      text: response,
                      icon: "success",
                      heightAuto: false,
                    });
                  $(self).prop("disabled", false);
                  resetSendeEkleForm();
                },
                error: function (err) {
                  Swal.fire({
                    title: "Hata!",
                    text: err.responseJSON.message,
                    icon: "error",
                    confirmButtonText: "ok",
                    heightAuto: false,
                  });
                  $(self).prop("disabled", false);
                },
              });
            } else {
              Swal.fire({
                title: "Hata!",
                text: "Lütfen zorunlu alanları doldurunuz!",
                icon: "error",
                confirmButtonText: "ok",
                heightAuto: false,
              });
            }
          });


        Annotorious.SelectorPack(anno, {
          tools: ['rect', 'polygon', 'circle']
        });
        Annotorious.Toolbar(anno, document.getElementById('openseadragon1'));
        Annotorious.BetterPolygon(anno);
        Annotorious.SequenceMode(anno, viewer);

        anno.on('createSelection', async function(selection) {

          // Tag to insert
          selection.body = [{
            type: 'TextualBody',
            purpose: 'tagging',
            value: 'Maddebasi'
          }];

          await anno.updateSelected(selection);
          anno.saveSelected();
          // Alternative:
          // anno.updateSelected(selection, true);
        });

        anno.on('createAnnotation', async function(annotation, overrideId) {
          //$('#bulunduguKoordinatlar').val(JSON.stringify(annotation));
          // console.log('createAnnotation:', annotation, overrideId );
          // console.log('sayfa:', viewer.currentPage(), imagedata.pages[viewer.currentPage()]);
          const koordinates =  await anno.getAnnotations();
          bulunduguMap.set(imagedata.pages[viewer.currentPage()],JSON.stringify(koordinates));
        });

        anno.on('deleteAnnotation', async function(annotation) {
         // $('#bulunduguKoordinatlar').val(null);
        // console.log('deleteAnnotation:', annotation);
          const koordinates =  await anno.getAnnotations();
          bulunduguMap.set(imagedata.pages[viewer.currentPage()],JSON.stringify(koordinates));
        });

        anno.on('updateAnnotation', async function(annotation, previous) {
          // $('#bulunduguKoordinatlar').val(JSON.stringify(annotation));
          // console.log('updateAnnotation:', annotation);
          const koordinates =  await anno.getAnnotations();
          bulunduguMap.set(imagedata.pages[viewer.currentPage()],JSON.stringify(koordinates));
        });
    });

    $('#sonrakiSetYukle').click(function(){
        let nextimagedata= JSON.parse('<%-JSON.stringify(nextSet)%>');

        nextimagedata.pages.forEach((image, i)=>{
          theTileSources.push({
                    type: 'image',
                    url: image,
                      });
          });

          viewer.open(theTileSources, nextimagedata.pages.length);
          $(this).off('click');
          var msg = `<div class="alert alert-info">Sondaki ${nextimagedata.pages.length} sayfa referans işlemi için sunulmaktadır. Madde girişi yapmayınız.</div>`;
          $(msg).insertAfter('#sonrakiSetYukle');
    });

</script>