              $(".eserTxtSection").hide();
              $(".locationSection").hide();
              $(".sozSection").hide();
            } else if (target === 'tamlama' || target === 'kalıp' || target === 'atasözü' || target === 'deyim') {
              $(".digeryazimSection").show();
              $('#karsiDilEkle').show();
              $(".detailSection").hide();
              $(".eserSection").hide();
              $(".sekilSection").show();
              $(".kokleriSection").show();
              $(".tariharaligiSection").hide();
              $(".eserTxtSection").hide();
              $(".locationSection").hide();
              $(".sozSection").hide();
            } else if (target === 'kişi' || target === 'olay') {
              $(".digeryazimSection").show();
              $('#karsiDilEkle').show();
              $(".detailSection").hide();
              $(".eserSection").hide();
              $(".sekilSection").hide();
              $(".kokleriSection").hide();
              $(".tariharaligiSection").hide();
              $(".eserTxtSection").hide();
              $(".locationSection").hide();
              $(".sozSection").hide();
            } else if(target === 'eser') {
              $(".digeryazimSection").show();
              $('#karsiDilEkle').show();
              $(".detailSection").hide();
              $(".eserSection").show();
              $(".sekilSection").hide();
              $(".kokleriSection").hide();
              $(".tariharaligiSection").hide();
              $(".eserTxtSection").show();
              $(".locationSection").hide();
