.sayfa-isaretle-grid {
  display: grid;
  gap: 15px;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  margin-bottom: 30px;
  padding-inline: 30px;
}
.sayfa-isaretle-grid .custom-check {
  position: relative;
  cursor: pointer;
}
.sayfa-isaretle-grid .custom-check > [type=checkbox] {
  display: none;
}
.sayfa-isaretle-grid .custom-check > [type=checkbox] + span {
  display: block;
}
.sayfa-isaretle-grid .sayfa-isaretle {
  text-align: center;
}
.sayfa-isaretle-grid .sayfa-isaretle .sayfa-isaretle-card {
  border: 2px solid #ebebeb;
  border-radius: 10px;
  background-color: #fff;
  font-size: 14px;
  color: #7f7f7f;
  padding: 15px;
  margin-bottom: 10px;
}
.sayfa-isaretle-grid .sayfa-isaretle__dosya {
  font-weight: 600;
  color: #222;
  margin-bottom: 5px;
  font-size: 15px;
}
.sayfa-isaretle-grid .sayfa-isaretle__text {
  line-height: 1.1;
  text-align: left;
  color: #999;
}
.sayfa-isaretle-grid .sayfa-isaretle-pseudo-btn {
  background-color: #c3c3c3;
  color: #fff;
  border-radius: 8px;
  padding: 5px 20px;
}
.sayfa-isaretle-grid .custom-check > [type=checkbox]:checked + span .sayfa-isaretle-card {
  border-color: #eebc34;
}
.sayfa-isaretle-grid .custom-check > [type=checkbox]:checked + span .sayfa-isaretle-pseudo-btn {
  background-color: #eebc34;
}
.sayfa-isaretle-grid .custom-check > [type=checkbox][disabled] + span {
  background: #f00;
}

  </style>

