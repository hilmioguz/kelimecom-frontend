            } else if(target === 'yeradı') {
              $(".digeryazimSection").show();
              $('#karsiDilEkle').show();
              $(".detailSection").hide();
              $(".eserSection").hide();
              $(".sekilSection").hide();
              $(".kokleriSection").hide();
