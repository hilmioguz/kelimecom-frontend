<%- contentFor('headerBlock') %>
<link href="assets/css/style.css" rel="stylesheet">

<%- contentFor('body') %>
<header>
    <%- include('partials/menu'); -%>
</header>
  <main role="main" class="alt-sayfa">
    <div class="container-fluid">

        <div class="row">

            <!-- ANA İÇERİK BASLANGICI -->
            <div class="col-md-18 col-lg-16 col-xl-13 mx-auto">
                <section class="blog-link-gorsel" style="background-image: url(assets/img/blog-img.jpg);">
                  <div class="blog-link__wrapper">
                    <div class="blog-link__link">
                        <a><span><%- __('latestarticles') %></span></a>
                    </div>
                  </div>
                </section>
                <section class="pb-5">
                    <div class="section-ara-baslik"></div>
                    <div class="card-deck">
                    <% if(blogs.length) {
                        blogs.map((blog) => { %>
                            <div class="card blog-list-card">
                                <img src="<%= blog.image %>" class="card-img-top blog-list-card__thumbnail" >
                                <div class="card-body">
                                    <h5 class="card-title"><%= blog.title %></h5>
                                    <p class="card-text mb-1"><small class="text-muted blog-list-card__yazar"><%- __('writer') %>: <%= blog.author %></small></p>
                                    <p class="card-text blog-list-card__yazi"><%- blog.body.substring(0, 300) %></p>
                                </div>
                                <div class="card-footer">
                                    <a href="/blog/<%= blog.slug %>" class="stretched-link"><%- __('readmore') %> >></a>
                                </div>
                            </div>
                        <% });
                        };
                    %>
                    </div>
                </section>
                <!-- <div class="row mb-4">
                    <div class="col">
                        <nav class="sozluk-pagination">
                            <ul class="pagination pagination-lg">
                                <li class="page-item active"><span class="page-link">1</span></li>
                                <li class="page-item"><a class="page-link" href="#">2</a></li>
                                <li class="page-item"><a class="page-link" href="#">3</a></li>
                                <li class="page-item"><a class="page-link" href="#">4</a></li>
                                <li class="page-item"><a class="page-link" href="#">5</a></li>
                            </ul>
                        </nav>
                    </div>
                </div> -->

            </div>
            <!-- ANA İÇERİK SONU -->

        </div>
    </div>
    <%- include('partials/visitblog'); -%>
    <%- include('partials/profile-sidenav'); -%>
</main>

<%- contentFor('footerBlock') %>



