<%- contentFor('headerBlock') %>
<title>Kelime.com Giriş</title>
<link rel="stylesheet" type="text/css" href="/login-assets/css/bootstrap.min.css">
<link rel="stylesheet" type="text/css" href="/login-assets/css/fontawesome-all.min.css">
<link rel="stylesheet" type="text/css" href="/login-assets/css/iofrm-style.css">
<link rel="stylesheet" type="text/css" href="/login-assets/css/iofrm-theme3.css">
<style>
    .form-content label.error {
      color: #ad4a01!important;
    }
</style>
<%- contentFor('body') %>
<div class="form-body" class="container-fluid">
    <div class="website-logo">
        <a href="/">
            <div class="logo">
                <img class="logo-size" src="/assets/img/logo.svg" alt="">
            </div>
        </a>
    </div>
    <div class="row">
        <div class="img-holder">
            <div class="bg"></div>
            <div class="info-holder">

            </div>
        </div>
        <div class="form-holder">
            <div class="form-content">
                <div class="form-items">
                    <div class="page-links">
                        <a href="./login" class="active"><%- __('login_') %></a><a href="./register"><%- __('register_') %></a>
                    </div>
                    <h5 class="text-center mb-5"><%- __('new_pasword_title') %></h5>
                    <form id="reset-form" method="post" action="javascript:;">
                        <input class="form-control" type="password" name="password" id="password" placeholder="<%- __('new_password') %>" autocomplete="new-password" required>
                        <input class="form-control" type="password" name="password2" placeholder="<%- __('new_password2') %>" autocomplete="new-password" required>
                        <% if (token) { %> <input class="form-control" type="hidden" name="token" value="<%= token %> "><% } %>
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="form-button">
                                <button id="reset-button" type="button" class="ibtn"><%- __('renew') %></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<%- contentFor('footerBlock') %>
<script>
 $(document).ready(function () {
  const filedrequired = `<%- __('field_required') %>`;
  const invalidemail = `<%- __('invalid_email') %>`;
  const giristext = `<%- __('login_') %>`;
  const errortext = `<%- __('error') %>`;
  const wronglogin= `<%- __('wrong_login') %>`;
  const registertext = `<%- __('register') %>`;
  const atleastcriter = `<%- __('atleast_criter') %>`;
  const invalidemailcriter = `<%- __('invalid_email_criter') %>`;
  const minlengthcriter = `<%- __('minlength') %>`;
  const minlengthchar = `<%- __('minlengthcharacter') %>`;
  const notmatch = `<%- __('passwordnotmatched') %>`;
  const successheader = `<%- __('success') %>`;
  const successmessage = `<%- __('register_success_msg') %>`;
$("#reset-form").validate({
  rules: {
    password: {
      required: true,
      minlength: 8,
      regex: "[^wd]*(([0-9]+.*[A-Za-z]+.*)|[A-Za-z]+.*([0-9]+.*))",
    },
    password2: {
      required: true,
      minlength: 8,
      equalTo: "#password",
      regex: "[^wd]*(([0-9]+.*[A-Za-z]+.*)|[A-Za-z]+.*([0-9]+.*))",
    },
  },
  messages: {
    password: {
      required: filedrequired,
      minlength: minlengthchar,
      atleastone: atleastcriter,
    },
    password2: {
      required: filedrequired,
      minlength: minlengthchar,
      equalTo: notmatch,
      atleastone: atleastcriter,
    },
  },
});

$("button#reset-button").on("click", function () {
  if ($("#reset-form").valid()) {
    $(this).prop("disabled", true);
    $(this).html('<i class="fa fa-spinner fa-spin fa-lg fa-fw"></i>');
    const that = this;
    $.ajax({
      url: "/reset-password",
      method: "post",
      data: $("form#reset-form").serialize(),
      success: function (result) {
        Swal.fire({
          title: successheader,
          text: result,
          type: "success",
          heightAuto: false,
        }).then(() => {
          window.location = "/";
        });
      },
      error: function (err) {
